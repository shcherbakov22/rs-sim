# bench: active/hopper-storage.case run for 20000 ticks
# Hopper-line bulk storage: two rows of 16 hoppers pour an input chest into double chests,
# comparators read each chest into a lamp. The stock drains early, then the storage idles.
tmc-case 2
size 16 5 7
key
  s = minecraft:stone
  e = minecraft:hopper[enabled=true,facing=east]
  d = minecraft:hopper[enabled=true,facing=down]
  R = minecraft:chest[facing=south,type=right,waterlogged=false]
  L = minecraft:chest[facing=south,type=left,waterlogged=false]
  i = minecraft:chest[facing=south,type=single,waterlogged=false]
  k = minecraft:comparator[facing=north,mode=compare,powered=false]
  l = minecraft:redstone_lamp[lit=false]
layer 0
  . . . . . . . . . . . . . . . .
